filters:
  and:
    - file.ext == "md"
    - or:
        - file.inFolder("20-概念")
        - file.inFolder("30-资料")
        - file.inFolder("40-实践")
properties:
  file.name:
    displayName: 笔记
  note.type:
    displayName: 类型
  note.status:
    displayName: 状态
  note.topics:
    displayName: 主题
  note.created:
    displayName: 创建日期
  note.next_review:
    displayName: 下次复习
  file.mtime:
    displayName: 最近修改
views:
  - type: table
    name: 全部笔记
    order:
      - file.name
      - note.type
      - note.status
      - note.topics
      - note.next_review
      - file.mtime
  - type: table
    name: 正在学习
    filters:
      or:
        - status == "待整理"
        - status == "学习中"
    order:
      - file.name
      - note.status
      - note.topics
      - note.next_review
  - type: table
    name: 到期复习
    filters:
      and:
        - status != "已掌握"
        - if(next_review, date(next_review) <= today(), false)
    order:
      - file.name
      - note.next_review
      - note.status
      - note.topics
  - type: table
    name: 待复习
    filters: status == "待复习"
    order:
      - file.name
      - note.next_review
      - note.topics
